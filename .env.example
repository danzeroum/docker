DOMAIN=docker.danzeroum.com
EMAIL=seu@email.com

# Basic auth do ingress. E daqui que sai o "quem" da auditoria, via
# proxy_set_header Remote-User — sem esse header o unlock responde 401.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=troque-essa-senha

SOCKET_PROXY=http://docker-socket-proxy:2375

# Subnet real da rede do ingress. Ausente ou errada => unlock nega com 403
# (fail-closed, por desenho). O IP do gateway muda a cada recriacao; a subnet nao.
# docker network inspect btv-prod-net --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_GATEWAY_CIDR=172.19.0.0/16

# NAO existe UNLOCK_TOKEN. O token de destravamento e gerado por sessao em
# POST /api/session/unlock (aleatorio, 30 min, guardado so como hash) e nunca
# vem de configuracao. Se encontrar UNLOCK_TOKEN num .env de producao, remova:
# a partir da migration v8 ele nao e aceito em X-Cockpit-Unlock de todo modo.

# Custo mensal do servidor, para o cartao de custo do Resumo executivo.
# Nao existe fonte automatica para isto. Vazio => o cartao some da tela,
# em vez de mostrar "R$ 0" — dado inventado e pior que campo ausente.
COST_MONTHLY=

# Mapa dominio -> nome de negocio do Resumo executivo.
# cp app/config/servicos.example.json app/config/servicos.json
# Ausente => a tela avisa e mostra os servicos como "nao mapeado".
SERVICOS_CONFIG=/app/config/servicos.json
